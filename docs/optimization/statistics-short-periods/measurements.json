    "candidateSql": "-- Admission candidate only: do not apply until the measured bound is accredited.\n-- Ninety days is the experiment ceiling, not a production eligibility decision.\nCREATE OR REPLACE FUNCTION public.get_conversion_statistics_short(p_request jsonb)\nRETURNS jsonb\nLANGUAGE plpgsql\nSTABLE\nSECURITY INVOKER\nSET search_path = ''\nSET statement_timeout = '8s'\nAS $function$\nDECLARE\n  from_at timestamptz := (p_request->>'from')::timestamptz;\n  to_at timestamptz := (p_request->>'to')::timestamptz;\nBEGIN\n  IF (SELECT auth.uid()) IS NULL THEN\n    RAISE EXCEPTION 'Authentication required' USING ERRCODE = '42501';\n  END IF;\n  IF from_at IS NULL OR to_at IS NULL OR NOT isfinite(from_at) OR NOT isfinite(to_at)\n    OR to_at < from_at OR to_at - from_at >= interval '90 days'\n    OR coalesce(p_request->>'view', '') <> 'stats' THEN\n    RAISE EXCEPTION 'A bounded statistics period is required' USING ERRCODE = '22023';\n  END IF;\n  RETURN public.get_conversion_report(p_request);\nEND\n$function$;\nREVOKE ALL ON FUNCTION public.get_conversion_statistics_short(jsonb) FROM PUBLIC, anon;\nGRANT EXECUTE ON FUNCTION public.get_conversion_statistics_short(jsonb) TO authenticated;\n",

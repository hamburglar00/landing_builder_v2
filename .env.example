# Copiar los valores necesarios a frontend/.env.local para ejecutar Next.js.
# Local example only. Use a public client key, never a service_role or secret key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-client-key

# Solo servidor de la landing pública. Nunca usar NEXT_PUBLIC_ para secretos.
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_CHAT_ORIGIN=
INTERNAL_CHAT_PLAYER_RESOLVE_KEY=
API2_ORIGIN=
API2_GATEWAY_API_KEY=
REY_GATEWAY_ORIGIN=https://reydeases-gateway.vercel.app
REY_GATEWAY_HANDOFF_API_KEY=
MULTI_SKIN_GATEWAY_ORIGIN=http://localhost:3001
MULTI_SKIN_GATEWAY_HANDOFF_API_KEY=
# Exclusiva del bypass /testing; debe coincidir con TESTING_HANDOFF_API_KEY del gateway.
MULTI_SKIN_GATEWAY_TESTING_API_KEY=
# Pase opaco y canal privado usados para mostrar el gateway de inmediato,
# mientras Atrio/API2/login se completan del lado servidor.
TEMPLATE7_PREPARATION_TOKEN_KEY=
TEMPLATE7_PREPARATION_API_KEY=
# Secreto exclusivo de servidor para anonimizar buckets del rate limit durable.
TEMPLATE7_RATE_LIMIT_HMAC_KEY=
# Template 7: API2 todavía no publicó el contrato idempotente de cuenta.
# Hasta publicarse el contrato de API2, /api/template7/start devuelve
# integration_pending y NO llama a ninguno de los gateways.

# Demo E2E de Template 7: solo servidor, deshabilitada por defecto.
# Activar únicamente con allowlists explícitas y credenciales de una cuenta de prueba.
TEMPLATE7_DEMO_ENABLED=false
TEMPLATE7_DEMO_SESSION_SECRET=
TEMPLATE7_DEMO_LANDING_IDS=
TEMPLATE7_DEMO_ADVISOR_IDS=
TEMPLATE7_DEMO_DEVICE_ID=
TEMPLATE7_DEMO_REY_USERNAME=
TEMPLATE7_DEMO_REY_PASSWORD=
# Habilita landings /testing de Multi Skin. Las credenciales viven solamente
# en MULTI_SKIN_TEST_USERNAME/PASSWORD dentro del gateway.
TEMPLATE7_DEMO_MULTI_SKIN_ENABLED=false
